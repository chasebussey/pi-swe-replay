{
  "schemaVersion": 1,
  "status": "implementation-contract-not-selectable-policy",
  "choice": {
    "values": ["agentless", "tsc"],
    "default": "agentless",
    "scope": "per-run",
    "cancelBeforeRunCreation": true
  },
  "identity": {
    "policy": "complete-tree-tsc-mixed-v1",
    "canonicalization": "tsc-canonical-tree-v1",
    "helpers": "added-helper-residual-v1",
    "registry": "python-typescript-files-v1",
    "sourceFallback": "lossless-paired-source-v1",
    "framing": "tagged-json-arrays-utf8-sha256-v1",
    "helperCollectionOrder": "utf8-byte-order-of-json-name-and-declaration",
    "pathOrder": "raw-path-byte-order",
    "retainLiteralSpelling": true,
    "retainExistingCodeOrder": true,
    "retainResidualEdits": true,
    "requireResidualEqualBaseline": false,
    "classifyDocumentationBeforeSubtraction": true,
    "emptyHelperCollectionUsesSameFrame": true
  },
  "languages": [
    {
      "language": "python",
      "rootType": "module",
      "extensions": [".py"],
      "helpers": ["top-level-named-function-with-body", "async-function", "generator-function", "decorated-function"]
    },
    {
      "language": "typescript",
      "rootType": "program",
      "extensions": [".ts"],
      "helpers": ["top-level-named-function-with-body", "async-function", "generator-function", "named-export-function"]
    }
  ],
  "unsupportedExtensions": [".pyi", ".mts", ".cts", ".tsx", ".js", ".jsx"],
  "extensionMatching": "case-sensitive-byte-suffix",
  "typescriptDeclarationFiles": "ordinary-typescript-with-no-body-declarations-in-residual",
  "unsupportedHelperForms": ["nested-function", "method", "arrow-binding", "ambient-or-no-body-declaration", "default-export-function", "anonymous-function"],
  "duplicateFunctionNames": "disable-extraction-for-file",
  "encoding": {
    "decode": "strict-utf8",
    "leadingUtf8Bom": "parse-after-marker-retain-marker-in-source-envelope",
    "bomOnlyDifference": "different",
    "stripCarriageReturns": false,
    "rewriteFinalNewlines": false,
    "invalidUtf8": "paired-exact",
    "nul": "paired-exact"
  },
  "persistence": {
    "newRunContractVersion": 1,
    "newRecordVersions": {
      "root": 2,
      "base": 2,
      "identity": 2,
      "finalSelection": 2,
      "candidate": 1,
      "evaluation": 1,
      "restoration": 1
    },
    "legacyAgentless": "read-captured-v1-with-existing-explicit-provenance",
    "legacyAutomaticFinalization": false,
    "inferMissingNewContract": false,
    "mixedRunPolicies": "reject"
  },
  "execution": {
    "batchTimeoutMs": 60000,
    "workersPerBatch": 1,
    "runtimeNetwork": false,
    "sourceErrors": "paired-exact-with-diagnostic",
    "infrastructureErrors": "fatal-whole-batch",
    "limitsAffectSuccessfulIdentity": false
  },
  "resourceProfile": {
    "name": "bounded-tsc-sources-v1",
    "scope": "source-worker-batch",
    "workerProtocolVersion": 1,
    "defaultTimeoutMs": 60000,
    "maxTimeoutMs": 60000,
    "minimumWorkerHeapMb": 64,
    "minimumWorkerStackMb": 2,
    "limits": {
      "maxSources": 512,
      "maxUniqueSources": 256,
      "maxPathBytes": 4096,
      "maxSourceBytes": 524288,
      "maxBatchBytes": 8388608,
      "maxUniqueBytes": 4194304,
      "maxSourceNodes": 100000,
      "maxBatchNodes": 500000,
      "maxDepth": 256,
      "maxSourceCanonicalBytes": 4194304,
      "maxBatchCanonicalBytes": 16777216,
      "maxResponseBytes": 50331648,
      "workerHeapMb": 256,
      "workerStackMb": 4
    },
    "batchByteAccounting": "id-utf8-plus-raw-path-plus-content-including-duplicates",
    "uniqueByteAccounting": "raw-content-deduplicated-by-language-and-sha256",
    "overrides": "tighten-only",
    "candidateFileAndWorkspaceReadBounds": "bounded-tsc-workspace-v1",
    "memoryCaveat": "not-a-hard-rss-limit-or-security-sandbox"
  },
  "workspaceResourceProfile": {
    "name": "bounded-tsc-workspace-v1",
    "scope": "complete-tree-reads-and-identity-framing",
    "limits": {
      "maxCandidates": 128,
      "maxTreeEntries": 100000,
      "maxTreeListingBytes": 16777216,
      "maxBatchListingBytes": 67108864,
      "maxChangedFiles": 256,
      "maxBatchChangedFiles": 256,
      "maxBlobBytes": 8388608,
      "maxReadBytes": 33554432,
      "maxIdentityBytes": 33554432
    },
    "overrides": "tighten-only",
    "sourceReservations": "conservative-before-read-including-possible-fallbacks-and-identical-shortcuts",
    "identityBound": "conservative-before-canonical-projection-and-exact-base64-framing",
    "memoryCaveat": "not-a-hard-rss-limit-or-security-sandbox"
  },
  "trustedCodeLoader": {
    "package": "jiti", "version": "2.7.0", "fsCache": false,
    "tryNative": false, "candidatePathsImported": false
  },
  "grammarAcquisition": {
    "policy": "tree-sitter-github-releases-v1",
    "source": "github-tree-sitter-organization-releases-only",
    "phase": "host-provisioning-before-offline-normalization",
    "networkAllowedInProvisioning": true,
    "mutableLatest": false,
    "mirrorsOrAggregators": false,
    "arbitraryUrlConfiguration": false,
    "cache": "sha256-content-addressed-verified-on-acquisition",
    "workerMustReverifyLoadedBytes": true,
    "failure": "fatal-not-exact-content-fallback",
    "defaultTimeoutMs": 30000,
    "maxTimeoutMs": 120000,
    "maxRedirects": 3,
    "maxRegistryAssetBytes": 8388608,
    "maxErrorBodyBytes": 2048,
    "redirectHosts": ["release-assets.githubusercontent.com", "objects.githubusercontent.com"],
    "sources": [
      { "language": "python", "repository": "tree-sitter/tree-sitter-python", "releaseTag": "v0.25.0", "asset": "tree-sitter-python.wasm", "bytes": 457883 },
      { "language": "typescript", "repository": "tree-sitter/tree-sitter-typescript", "releaseTag": "v0.23.2", "asset": "tree-sitter-typescript.wasm", "bytes": 1413849 }
    ]
  },
  "dependencies": [
    {
      "package": "web-tree-sitter",
      "version": "0.27.1",
      "asset": "web-tree-sitter.wasm",
      "bytes": 210415,
      "sha256": "beca80e44cccbf2299ed4d1e3fa6462a9a6fe818aeebf847547a392227ce4acc",
      "license": "MIT"
    },
    {
      "package": "tree-sitter-python",
      "version": "0.25.0",
      "asset": "tree-sitter-python.wasm",
      "sha256": "16108b50df4ee9a30168794252ab55e7c93bfc5765d7fa0aa3e335752c515f47",
      "license": "MIT"
    },
    {
      "package": "tree-sitter-typescript",
      "version": "0.23.2",
      "asset": "tree-sitter-typescript.wasm",
      "sha256": "778025db5a8be0e70f8ccc3671e486dfeddd048c25d9e8a70c26de2e1bf6f97d",
      "license": "MIT"
    }
  ],
  "implementationGates": [
    { "id": "resource-profile", "owner": "P5", "status": "bounded-complete-tree-and-captured-execution-validated", "blocksRuntimeEnablement": false },
    { "id": "interpolation-adapters", "owner": "P1/P2", "status": "core-and-worker-validated", "blocksRuntimeEnablement": false },
    { "id": "installed-package-offline-assets", "owner": "P6", "status": "source-worker-validated-pending-replay-integration", "blocksRuntimeEnablement": true },
    { "id": "upstream-provisioning-installed-location", "supersedes": "grammar-install-hooks", "owner": "P2", "status": "validated-source-api", "blocksRuntimeEnablement": false },
    { "id": "helper-tree-record-integration", "owner": "P5", "status": "v2-contract-archive-and-finalization-validated", "blocksRuntimeEnablement": false },
    { "id": "user-policy-choice", "owner": "P6", "status": "pending-choice-and-captured-policy-display", "blocksRuntimeEnablement": true },
    { "id": "integrated-replay-validation", "owner": "P7", "status": "pending-installed-and-real-pi-validation", "blocksRuntimeEnablement": true }
  ]
}
